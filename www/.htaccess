Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^logs(/|$) - [F,L]
  RewriteRule ^db_migrations(/|$) - [F,L]
</IfModule>

<FilesMatch "\.log$">
  Require all denied
</FilesMatch>

<FilesMatch "^config\.local\.php(\.example)?$">
  Require all denied
</FilesMatch>

<FilesMatch "^schema\.sql$">
  Require all denied
</FilesMatch>
